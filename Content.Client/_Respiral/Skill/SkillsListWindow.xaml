<DefaultWindow
    xmlns="https://spacestation14.io"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cc="clr-namespace:Content.Client.Administration.UI.CustomControls"
    Title="{Loc 'skills-list-window-title'}"
    MinWidth="420"
    MinHeight="420"
    SetSize="560 600">
    <BoxContainer Orientation="Vertical" Margin="10" SeparationOverride="8">
        <PanelContainer StyleClasses="tooltipBox" HorizontalExpand="True">
            <BoxContainer Orientation="Vertical" Margin="10">
                <Label Name="TargetNameLabel" Access="Public" HorizontalAlignment="Center" StyleClasses="LabelHeading"/>
            </BoxContainer>
        </PanelContainer>
        <ScrollContainer VerticalExpand="True" HorizontalExpand="True" HScrollEnabled="False">
            <BoxContainer Name="SkillsContainer" Access="Public" Orientation="Vertical" HorizontalExpand="True" SeparationOverride="8"/>
        </ScrollContainer>
    </BoxContainer>
</DefaultWindow>
